      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "search_kb",
            "args": {
              "category": "meeting_room"
            }
          }
        ]
      },
      "metadata": {
        "skill": "route_howto",
        "difficulty": "medium",
        "what_it_tests": "Yêu cầu hướng dẫn thiết bị phòng họp phải vào knowledge base đúng nhóm, không nhảy sang hardware hay inspect_device."
      }
    },
    {
