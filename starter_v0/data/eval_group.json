{
  "dataset_id": "day04_v3_helpdesk_group",
  "dataset_role": "group",
  "description": "Team-authored cases for the IT Helpdesk Agent: 5 single-turn and 5 multi-turn. Written against assets, employees, services and knowledge categories that the fixed base suite does not exercise.",
  "allowed_failure_types": ["wrong_tool", "wrong_arg_value", "wrong_boundary", "unnecessary_tool", "out_of_scope", "missing_info"],
  "cases": [
    {
      "id": "G01_printing_service_routing",
      "phase": "B",
      "suite": "group",
      "query": "Hệ thống in ấn dùng chung ở production có đang bình thường không?",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "check_service_status",
            "args": {
              "service": "printing",
              "environment": "production"
            }
          }
        ]
      },
      "metadata": {
        "skill": "route_shared_service",
        "difficulty": "easy",
        "what_it_tests": "Dịch vụ in ấn dùng chung phải đi vào status tool, không được nhầm sang inspect_device của một máy in cụ thể."
      }
    },
    {
      "id": "G02_software_check_arg",
      "phase": "B",
      "suite": "group",
      "query": "Xem giúp mình danh sách phần mềm đang cài trên LT-411.",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "inspect_device",
            "args": {
              "asset_id": "LT-411",
              "check": "software"
            }
          }
        ]
      },
      "metadata": {
        "skill": "device_check_arg",
        "difficulty": "medium",
        "what_it_tests": "Người dùng nêu rõ phạm vi phần mềm thì phải chọn check=software, không rà tổng thể."
      }
    },
    {
